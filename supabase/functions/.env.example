# Edge Function secrets. Copy to supabase/functions/.env (gitignored), fill in, then:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically: do not set them.

# https://aistudio.google.com/apikey  (blank = scripted AI support call)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public ntfy.sh needs no token. Token only for a protected/self-hosted server.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOKEN=
