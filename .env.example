# Jam app environment (Expo). Copy to `.env` and fill in. Never commit `.env`.
# Every EXPO_PUBLIC_* value is bundled INTO THE APP and is public by design.
# Secrets (Gemini, ntfy token, service role) do NOT go here: they live in Supabase as
# Edge Function secrets. See supabase/functions/.env.example.

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> API. Use the anon / publishable key (NOT service_role).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth fallback ----------------------------------------------------------
# true = show sign-in with the seeded demo accounts (supabase/seed.sql).
EXPO_PUBLIC_ENABLE_DEV_LOGIN=true

# --- Mocks ------------------------------------------------------------------
# true = every service uses its mock even if Supabase is set (single-device only).
# Mocks also turn on automatically when the Supabase values are blank.
EXPO_PUBLIC_USE_MOCK_SERVICES=false

# --- Routing (OSRM) -----------------------------------------------------------
# Optional. Blank = predefined Campus Walk demo route.
# Public walking profile: https://routing.openstreetmap.de/routed-foot
EXPO_PUBLIC_OSRM_URL=
