{
  "expo": {
    "name": "Jam",
    "slug": "jam",
    "version": "0.1.0",
    "scheme": "jam",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbf8f3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.htv11.jam",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Jam shares your location with your Jam while it is active. You can pause it at any time.",
        "NSMicrophoneUsageDescription": "Jam records audio during an AI support call only if you turned on emergency recording.",
        "NSCameraUsageDescription": "Jam uses the camera to scan a Jam QR code."
      }
    },
    "android": {
      "package": "com.htv11.jam",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jam shares your location with your Jam while it is active. You can pause it at any time."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Jam records audio during an AI support call only if you turned on emergency recording."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Jam uses the camera to scan a Jam QR code.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a79dc90d-7e99-41e9-8939-787833576bda"
      }
    },
    "owner": "aditin5",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a79dc90d-7e99-41e9-8939-787833576bda"
    }
  }
}
